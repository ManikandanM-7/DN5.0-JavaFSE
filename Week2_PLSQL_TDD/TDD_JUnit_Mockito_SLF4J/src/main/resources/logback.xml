<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logback Configuration — SLF4J Implementation
    DN 5.0 Week 2 | Cognizant Java FSE
    Controls: log format, level, output destinations (appenders)
-->
<configuration>

    <!-- ── Console Appender — prints to stdout ── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Pattern: timestamp | level | thread | logger | message -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── File Appender — writes to logs/application.log ── -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Rotate daily, keep 30 days -->
            <fileNamePattern>logs/application.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── Error-only File Appender ── -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/errors.log</file>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- Security logger — separate file -->
    <appender name="SECURITY_FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/security.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} SECURITY %-5level - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── Logger Configuration ── -->

    <!-- Security events → their own file -->
    <logger name="com.cognizant.security" level="WARN" additivity="false">
        <appender-ref ref="SECURITY_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Application code → DEBUG level -->
    <logger name="com.cognizant" level="DEBUG"/>

    <!-- Root logger — INFO and above → console + files -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
